# Coolify → Environment Variables. Examples only; no live credentials.
# See docs/COOLIFY.md. Do not commit the populated file.
# APP_ORIGIN has no internal :3001 suffix; the Coolify Domains field does.
APP_ORIGIN=https://mola.psychodry.cloud

# First deployment can run without providers. Existing verified accounts can
# sign in; new registrations and recovery emails wait until SMTP is enabled.
EMAIL_DELIVERY_ENABLED=false
REQUIRE_TURN=false

# Add a reachable TURN relay and matching shared secret, then REQUIRE_TURN=true.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_URLS=
TURN_SECRET=

# SMTP: 587/false uses STARTTLS; 465/true uses implicit TLS.
# Fill every SMTP field and MAIL_ENCRYPTION_KEY, then EMAIL_DELIVERY_ENABLED=true.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Generate 32 bytes as 64 hex characters and keep the key with your backups.
MAIL_ENCRYPTION_KEY=

# Optional HTTPS endpoint accepting Alertmanager webhook JSON.
# Empty keeps internal monitoring active with no external notifications.
ALERT_WEBHOOK_URL=
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# Change to true only after configuring a separate backup repository.
OFFSITE_ENABLED=false
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
RESTIC_INTERVAL_SECONDS=86400
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_SESSION_TOKEN=
