# Docker Compose production configuration. Copy to .env and replace all examples.
# .env is read by Docker Compose and the local backend via dotenv.
APP_DOMAIN=mola.psychodry.cloud
APP_ORIGIN=https://mola.psychodry.cloud
PORT=3001
DATA_DIR=./data
TRUST_PROXY=1
# Optional private operations listener; unset preserves standalone Caddy/local setup.
# Coolify sets this to 9100 and routes backups/metrics to that internal port.
# OPS_PORT=9100
ENABLE_DEMO=false

# Comma-separated TURN URLs. Use a real, reachable relay server.
# TURN_SECRET must match coturn static-auth-secret. Never use a VITE_ prefix.
TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
TURN_SECRET=

# Production account verification and password recovery. TLS is mandatory.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Mola <noreply@example.com>
# Generate 32 bytes: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key with encrypted backups; changing it makes queued email unreadable.
MAIL_ENCRYPTION_KEY=

# Required production Alertmanager-compatible HTTPS webhook receiver.
# The receiver must accept Alertmanager JSON (a generic Slack webhook differs).
ALERT_WEBHOOK_URL=

# Full SQLite + upload snapshot scheduler. First backup runs immediately.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP=14

# Optional coturn profile: docker compose --profile turn up -d
TURN_REALM=turn.example.com
TURN_PUBLIC_IP=
# Directory containing readable fullchain.pem and privkey.pem for TURN_REALM.
TURN_CERTS_PATH=./secrets/turn

# Optional encrypted offsite profile: configure all fields before enabling.
# RESTIC_PASSWORD_PATH is relative to ops/ when a relative path is used.
OFFSITE_ENABLED=false
RESTIC_REPOSITORY=s3:https://s3.example.com/mola-backups
RESTIC_PASSWORD_PATH=../secrets/restic-password
RESTIC_INTERVAL_SECONDS=86400
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
